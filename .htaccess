# Ad Aircond Solution — Apache / cPanel configuration
# Static site: no rewrites needed, only compression, caching and MIME types.

# ---- Default document ----
DirectoryIndex index.html

# ---- Block repository metadata ----
# A .git directory left in the web root is readable over HTTP and exposes the
# project's history. Deny it whether or not one is actually present.
RedirectMatch 404 /\.git(/|$)
<IfModule mod_authz_core.c>
  <DirectoryMatch "/\.git">
    Require all denied
  </DirectoryMatch>
</IfModule>

# ---- Correct MIME types ----
# X-Content-Type-Options below is "nosniff", so a stylesheet served with the
# wrong type is refused outright and the page renders unstyled. Declare the
# types explicitly rather than trusting the host's defaults.
<IfModule mod_mime.c>
  AddType text/css                 .css
  AddType application/javascript   .js
  AddType text/html                .html
  AddType image/svg+xml            .svg
  AddType font/woff2               .woff2
  AddType application/json         .json
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # woff2 is already compressed — do not re-compress it.
</IfModule>

# ---- Browser caching ----
# The filenames here are not fingerprinted (styles.css stays styles.css after an
# edit), so CSS, JS and images are only cached briefly and revalidated. Caching
# them for a year would leave visitors on the old design after every update.
# Fonts never change, so they keep the long cache.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 hour"
  ExpiresByType application/javascript    "access plus 1 hour"
  ExpiresByType image/svg+xml             "access plus 1 day"
  ExpiresByType image/jpeg                "access plus 1 day"
  ExpiresByType image/webp                "access plus 1 day"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(svg|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Force HTTPS ----
# Most hosts (and Cloudflare) already do this. Only uncomment if yours does not,
# and only AFTER an SSL certificate is active — otherwise the site goes offline.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
